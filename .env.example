# ---------------------------------------------------------------------------
# Physiotherapy Treatment at Home — appointment-enquiry assistant
# Copy to .env.local (development) or set in your host's dashboard.
# PLACEHOLDERS ONLY. Never commit real values.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Any PostgreSQL 13+ (Supabase, Neon, RDS, self-hosted). Use the pooled URL on serverless hosts.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MAX=5

# --- Website embed ----------------------------------------------------------
# Space-separated origins allowed to show the chat in an iframe (the clinic website).
CHAT_EMBED_ALLOWED_ORIGINS=https://physiotherapytreatmentathome.com https://www.physiotherapytreatmentathome.com

# --- Optional AI provider (OpenAI-compatible; Groq by default) ---------------
# Only used to route free-text messages to the right menu option. Leave blank for rule-based mode.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_MS=4000

# --- Staff email notifications (optional) -----------------------------------
# Enter the clinic's real addresses only once the clinic has provided them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM_EMAIL=
STAFF_NOTIFICATION_EMAILS=

# --- WhatsApp Business Platform (Meta Cloud API) (optional) ------------------
# All four of these are required before the webhook goes live.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Business-initiated messages must use templates approved in WhatsApp Manager.
# Staff alert template body variables: {{1}} reference {{2}} patient {{3}} phone {{4}} date {{5}} time {{6}} locality
WHATSAPP_TEMPLATE_STAFF_ALERT=
# Patient status template body variables: {{1}} reference {{2}} status
WHATSAPP_TEMPLATE_PATIENT_STATUS=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Staff WhatsApp numbers for alerts, E.164 format, comma-separated
STAFF_WHATSAPP_NUMBERS=

# --- Operations --------------------------------------------------------------
# Secret for the scheduled notification-retry endpoint (POST /api/cron/notifications)
CRON_SECRET=
RATE_LIMIT_CHAT_PER_MIN=30
RETENTION_DAYS=365
